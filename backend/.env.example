# NexusERP-AI Backend Environment Variables Template

# Security
SECRET_KEY=your-production-django-secret-key
DEBUG=False
ALLOWED_HOSTS=your-backend-domain.com,api.yourdomain.com,127.0.0.1,localhost

# Database Configuration (PostgreSQL)
DB_NAME=nexuserp
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=your-postgres-host.rds.amazonaws.com
DB_PORT=5432

# CORS Configuration (Frontend URLs allowed to connect)
CORS_ALLOWED_ORIGINS=https://your-nexuserp-frontend.vercel.app,http://localhost:3000

# ==========================================================
# AI Copilot LLM Configuration
# ==========================================================

# Option 1: Free Groq Cloud API Key (RECOMMENDED for 24/7 Vercel deployment)
# Get your FREE high-speed API key at: https://console.groq.com
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: OpenAI API Key (Optional)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# Option 3: Local Ollama (Default if no cloud key is provided)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=60
